<launch>
  <!-- size of map, change the size inflate x, y, z according to your application -->
  <arg name="map_size_x"/>
  <arg name="map_size_y"/>
  <arg name="map_size_z"/>
  <arg name="target_x"/>
  <arg name="target_y"/>
  <arg name="target_z"/>

  <arg name="drone_id"/>

  <!-- topic of your odometry such as VIO or LIO -->
  <arg name="odom_topic"/>

  <!-- number of moving objects -->
  <arg name="obj_num" value="1" />

  <!-- main algorithm params -->
  <include file="$(find informed_rrt_star_planner)/launch/advanced_param_xtdrone.xml">

    <arg name="thresh_replan_time" value="0.25"/>

    <arg name="drone_id" value="$(arg drone_id)"/>

    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <arg name="obj_num_set" value="$(arg obj_num)" />

    <!-- camera pose: transform of camera frame in the world frame -->
    <!-- depth topic: depth image, 640x480 by default -->
    <!-- don't set cloud_topic if you already set these ones! -->
    <arg name="camera_pose_topic" value="/mavros/vision_pose/pose"/>
    <arg name="depth_topic" value="realsense/depth_camera/depth/image_raw"/>

    <!-- Disable dense rendered point cloud while tuning; depth image builds the local map. -->
    <arg name="cloud_topic" value="disabled_pcl_render_node/points"/>

    <!-- intrinsic params of the depth camera -->
    <arg name="cx" value="320.5"/>
    <arg name="cy" value="240.5"/>
    <arg name="fx" value="554.254691191187"/>
    <arg name="fy" value="554.254691191187"/>

    <arg name="max_vel" value="0.5" />
    <arg name="max_acc" value="1.15" />

    <arg name="planning_horizon" value="6.0" /> 

    <!-- 单机飞行关闭多备选轨迹可减少相邻周期轨迹形状随机切换引起的飘移感。 -->
    <arg name="use_distinctive_trajs" value="false" />

    <!-- 1: use 2D Nav Goal to select goal  -->
    <!-- 2: use global waypoints below  -->
    <arg name="flight_type" value="1" />
    
    <!-- global waypoints -->
    <!-- It generates a piecewise min-snap traj passing all waypoints -->
    <arg name="point_num" value="2" />

    <arg name="point0_x" value="$(arg target_x)" />
    <arg name="point0_y" value="$(arg target_y)" />
    <arg name="point0_z" value="$(arg target_z)" />

    <arg name="point1_x" value="6.0" />
    <arg name="point1_y" value="0.0" />
    <arg name="point1_z" value="1.5" />

    <arg name="point2_x" value="8.0" />
    <arg name="point2_y" value="-8.0" />
    <arg name="point2_z" value="1.5" />

    <arg name="point3_x" value="0.0" />
    <arg name="point3_y" value="-15.0" />
    <arg name="point3_z" value="1.0" />

    <arg name="point4_x" value="-15.0" />
    <arg name="point4_y" value="0.0" />
    <arg name="point4_z" value="1.0" />
    
  </include>

  <!-- trajectory server -->
  <node pkg="informed_rrt_star_planner" name="iris_$(arg drone_id)_traj_server" type="traj_server" output="screen">
    <remap from="position_cmd" to="/xtdrone/iris_$(arg drone_id)/planning/pos_cmd"/>
    <remap from="pose_cmd" to="/xtdrone/iris_$(arg drone_id)/cmd_pose_enu"/>
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~planning/bspline" to="/xtdrone/iris_$(arg drone_id)/planning/bspline"/>
    <remap from="~flown_path" to="/xtdrone/iris_$(arg drone_id)/planning/flown_path"/>

    <!-- 重规划加密后略缩前瞻，使 pos_cmd 更贴当前 spline，与新轨迹切换更合拍（仍不宜 &lt;0.03）。 -->
    <param name="traj_server/time_forward" value="0.42" type="double"/>
    <param name="traj_server/path_sample_dist" value="0.08" type="double"/>
    <param name="traj_server/path_sample_dt" value="0.12" type="double"/>
    <param name="traj_server/path_max_points" value="8000" type="int"/>
    <!-- false: 保留全程飞行历史；true: 每次重规划后清空，仅显示当前段 -->
    <param name="traj_server/path_reset_on_new_traj" value="false" type="bool"/>
  </node>

  <!-- RViz drone body visualization, published as /drone_N_odom_visualization/robot. -->
  <node pkg="odom_visualization" name="drone_$(arg drone_id)_odom_visualization" type="odom_visualization" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <param name="frame_id" value="map"/>
    <param name="mesh_resource" value="package://odom_visualization/meshes/iris.stl"/>
    <param name="robot_scale" value="0.5"/>
    <param name="color/a" value="1.0"/>
    <param name="color/r" value="1.0"/>
    <param name="color/g" value="0.58"/>
    <param name="color/b" value="0.22"/>
    <param name="tf45" value="false"/>
    <param name="drone_id" value="$(arg drone_id)"/>
  </node>
  
</launch>
